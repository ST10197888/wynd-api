        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const items = [];",
              "const stamp = Date.now();",
              "for (let i = 1; i <= 11; i++) {",
              "  items.push({ clientId: \"bulk-\" + stamp + \"-\" + i, locationName: \"Bulk City \" + i + \" \" + stamp });",
              "}",
              "pm.collectionVariables.set(\"bulkItems\", JSON.stringify(items));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const r = pm.response.json().results;",
              "pm.test(\"First 10 created\", function () { pm.expect(r.slice(0, 10).every(function (x) { return x.status === \"created\"; })).to.be.true; });",
              "pm.test(\"11th rejected\", function () { pm.expect(r[10].status).to.eql(\"rejected\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenB}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{userIdB}}/sync/locations",
          "host": [

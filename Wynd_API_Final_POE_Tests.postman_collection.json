        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Has temperature\", function () { pm.expect(pm.response.json()).to.have.property(\"temperature\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/weather/current?location=Johannesburg",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "weather",
            "current"
          ],
          "query": [
            {
              "key": "location",
              "value": "Johannesburg"
            }
          ]
        }
      }
    },

{
  "info": {
    "name": "Wynd Kennedy - Sections 4.1 and 4.2 Settings Authorization",
    "description": "Run in order. Fill loginEmail, loginPassword, and otherUserId (a DIFFERENT valid MongoDB user ID). The login request saves token and userId to collection variables. Do not export/share collection after login without removing token and credentials. This collection checks 6 settings scenarios plus login; it does not test the entire backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Login (captures token and userId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json(); pm.test(\"Token and userId returned\", () => { pm.expect(d.token).to.be.a(\"string\"); pm.expect(d.userId).to.be.a(\"string\"); }); if (d.token && d.userId) { pm.collectionVariables.set(\"token\", d.token); pm.collectionVariables.set(\"userId\", d.userId); }"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - GET own settings \u2014 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "settings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Settings object returned\", () => pm.expect(pm.response.json()).to.have.property(\"settings\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET another user settings \u2014 403",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{otherUserId}}/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{otherUserId}}",
            "settings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET settings without token \u2014 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "settings"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - GET settings invalid token \u2014 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "settings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "this.is.not.a.valid.jwt",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - PUT own settings \u2014 200",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "settings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperatureUnit\": \"C\",\n  \"windSpeedUnit\": \"km/h\",\n  \"timeFormat\": \"24h\",\n  \"theme\": \"System\",\n  \"language\": \"English\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Settings updated\", () => pm.expect(pm.response.json()).to.have.property(\"settings\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - PUT another user settings \u2014 403",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/{{otherUserId}}/settings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{otherUserId}}",
            "settings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperatureUnit\": \"C\",\n  \"windSpeedUnit\": \"km/h\",\n  \"timeFormat\": \"24h\",\n  \"theme\": \"System\",\n  \"language\": \"English\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "loginEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherUserId",
      "value": "",
      "type": "string"
    }
  ]
}
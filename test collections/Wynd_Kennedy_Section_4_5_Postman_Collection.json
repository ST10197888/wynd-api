            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Other user ID is configured',()=>{pm.expect(pm.collectionVariables.get('otherUserId')).to.be.a('string').and.not.empty;pm.expect(pm.collectionVariables.get('otherUserId')).not.to.eql(pm.collectionVariables.get('userId'));});",
              "pm.test('Cross-user access HTTP 403',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },

{
  "info": {
    "_postman_id": "9e2cb08c-c7fc-4f0d-9970-0a6c16676539",
    "name": "Wynd Kennedy \u2014 Section 4.5 Supabase Blob Storage",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run sequentially. Set loginEmail, loginPassword and otherUserId. Manually select files for requests 01, 04 and 09. Request 09 is optional and needs >2 MB image. A successful upload replaces the avatar pointer; old object may remain. Signed URLs are sensitive; do not share them."
  },
  "item": [
    {
      "name": "00 Login \u2014 capture token and userId",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{loginEmail}}\",\"password\":\"{{loginPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login HTTP 200',()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();",
              "pm.test('Token and userId returned',()=>{pm.expect(d.token).to.be.a('string').and.not.empty;pm.expect(d.userId).to.be.a('string').and.not.empty;});",
              "if(d.token && d.userId){pm.collectionVariables.set('token',d.token);pm.collectionVariables.set('userId',d.userId);}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Upload valid avatar \u2014 201",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/avatar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "avatar"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Upload HTTP 201',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json();pm.test('Storage object key returned',()=>{pm.expect(d.path).to.be.a('string');pm.expect(d.path).to.include('avatars/');});",
              "if(d.path)pm.collectionVariables.set('uploadedObjectKey',d.path);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET own avatar \u2014 200 signed URL",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/avatar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "avatar"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Avatar GET HTTP 200',()=>pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.test('Signed URL returned',()=>{pm.expect(d.url).to.match(/^https:\\/\\//);pm.expect(d.expiresIn).to.eql(3600);});",
              "if(d.url)pm.collectionVariables.set('signedAvatarUrl',d.url);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 GET another user avatar \u2014 403",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{otherUserId}}/avatar",

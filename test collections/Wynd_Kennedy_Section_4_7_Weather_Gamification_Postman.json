{
  "info": {
    "name": "Wynd Kennedy Section 4.7 \u2014 Weather and Gamification Verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Final uncovered-route checks. Prior collections for 4.1\u20134.6 should also be run for comprehensive regression. No credentials are included."
  },
  "item": [
    {
      "name": "00 Login and capture token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{loginEmail}}\", \"password\": \"{{loginPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.test(\"JWT and userId present\",()=>{pm.expect(j.token).to.be.a(\"string\").and.not.empty;pm.expect(j.userId).to.be.a(\"string\").and.not.empty;});",
              "if(j.token && j.userId){pm.collectionVariables.set(\"token\",j.token);pm.collectionVariables.set(\"userId\",j.userId);}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Current weather anonymous",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/weather/current?location={{weatherLocation}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "weather",
            "current"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const j=pm.response.json();pm.test(\"Current weather fields\",()=>{pm.expect(j).to.have.keys(\"location\",\"temperature\",\"condition\",\"humidity\");});"
            ]
          }
        }
      ]
    },

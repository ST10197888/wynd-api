{
  "info": {
    "name": "Wynd Kennedy \u2014 Section 4.6 Firebase Cloud Messaging",
    "_postman_id": "a0e3fb93-2e57-4c7c-bd17-85bd06a56b3c",
    "description": "Requests 00\u201309: security and validation. Requests 10\u201311: only run after obtaining a real device FCM token and confirming Firebase Admin is configured in Railway. Never commit populated credentials or tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Login \u2014 capture JWT and user ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Token and userId returned\", function () { pm.expect(data.token).to.be.a(\"string\").and.not.empty; pm.expect(data.userId).to.be.a(\"string\").and.not.empty; });",
              "if (data.token && data.userId) { pm.collectionVariables.set(\"token\", data.token); pm.collectionVariables.set(\"userId\", data.userId); }"
            ]
          }
        }
      ]
    },
